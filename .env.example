# ============================================================
#  CONFIGURACIÓN DEL AGENTE YOUTUBE
#  Este archivo es una PLANTILLA. Copia su contenido a un archivo
#  nuevo llamado `.env` (sin el ".example") y rellena tus valores.
#  El `.env` es privado y NUNCA se sube a GitHub (está en .gitignore).
# ============================================================

# ---------- IA DE TEXTO (DeepSeek) ----------
# Pega aquí tu clave: https://platform.deepseek.com/api_keys
# Sin clave, la app funciona igual en MODO DEMO (contenido de ejemplo).
DEEPSEEK_API_KEY=

# Modelo de texto. Opciones que expone DeepSeek:
#   deepseek-flash   -> rápido y barato (ideal para ideas y lotes grandes)
#   deepseek-v4-pro  -> más "inteligente" (ideal para guiones largos)
DEEPSEEK_MODEL=deepseek-flash

# Temperatura (0 = predecible / 2 = creativo). 1.1 va bien para guiones.
LLM_TEMPERATURE=1.1

# ---------- IMÁGENES (ComfyUI local) ----------
# Dirección donde escucha ComfyUI en tu PC
COMFYUI_URL=http://127.0.0.1:8188

# Nombre EXACTO del modelo .safetensors que tengas en ComfyUI\models\checkpoints
# (déjalo vacío para que el agente use el primer modelo que encuentre)
COMFYUI_CHECKPOINT=

# ---------- PREFERENCIAS DEL CANAL ----------
# Estilo visual fijo: se añade a TODOS los prompts para que el canal se vea igual
VISUAL_STYLE=cinematic photorealistic, teal and orange color grading, dramatic rim lighting, film grain, 35mm lens, shallow depth of field, ultra detailed

# Relación de aspecto por defecto de las imágenes (16:9 para YouTube)
IMAGE_ASPECT=16:9

# Idioma de los textos generados (por ahora, el proyecto genera en español;
# variable reservada para futuras versiones multiidioma)
LANGUAGE=es

# ---------- MODELO Y VELOCIDAD (ComfyUI) ----------
# Modelo instalado en ComfyUI\models\checkpoints
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors

# LoRA acelerador (4 pasos). Si no usas ninguno, deja la línea vacía.
COMFYUI_LORA=sdxl_lightning_4step_lora.safetensors

# Ajustes del muestreador (con Lightning: 4 pasos y cfg 1.5)
IMAGE_STEPS=4
IMAGE_CFG=1.5
IMAGE_SAMPLER=euler
IMAGE_SCHEDULER=sgm_uniform